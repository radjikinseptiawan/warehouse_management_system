generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model user {
  id       String  @id @default(cuid())
  name     String?
  email    String? @unique
  password String
  role     Role
}

model vendors {
  id            Int      @id @default(autoincrement())
  nama_vendor   String
  warna_vendor  String
  alamat_vendor String
  produk        produk[]
}

model category {
  id             Int      @id @default(autoincrement())
  nama_kategori  String
  warna_category String
  produk         produk[]
}

model satuan{
  id Int @id @default(autoincrement())
  nama_satuan String?
}

model lokasi_gudang {
  id            Int      @id @default(autoincrement())
  nama_gudang   String
  alamat_gudang String
  warna_gudang  String
  produk        produk[]
}

model produk {
  id            Int             @id @default(autoincrement())
  nama_produk   String
  kategoriId    Int
  vendorsId     Int
  jumlah        Int             @default(0)
  lokasiId      Int
  gambar_produk String?
  is_delete     Boolean         @default(false)
  public_id     String?
  outbound      barang_keluar[]
  inbound       barang_masuk[]
  kategori      category        @relation(fields: [kategoriId], references: [id])
  lokasi        lokasi_gudang   @relation(fields: [lokasiId], references: [id])
  vendors       vendors         @relation(fields: [vendorsId], references: [id])
}

model barang_masuk {
  id                  Int      @id @default(autoincrement())
  produkId            Int
  tanggal_masuk       DateTime @default(now())
  nominal_modal       Int
  jumlah_barang_masuk Int
  produk              produk   @relation(fields: [produkId], references: [id])
}

model barang_keluar {
  id                   Int      @id @default(autoincrement())
  produkId             Int
  tanggal_keluar       DateTime @default(now())
  nominal_modal        Int
  jumlah_barang_keluar Int
  produk               produk   @relation(fields: [produkId], references: [id])
}

enum Role {
  ADMIN
  USER
}
