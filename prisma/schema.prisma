// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}


// Tabel vendor
model vendors{
  id Int @id @default(autoincrement())
  nama_vendor String 
  warna_vendor String
  alamat_vendor String
  produk produk[]
}

// Tabel Kategori
model category{
  id Int @id @default(autoincrement())
  nama_kategori String
  warna_category String
  produk produk[]
}

// Tabel Lokasi Gudang
model lokasi_gudang{
  id Int @id @default(autoincrement())
  nama_gudang String
  alamat_gudang String
  warna_gudang String
  produk produk[]
}

// Tabel Produk
model produk{
  id Int @id @default(autoincrement())
  nama_produk String
  kategoriId Int
  kategori category @relation(fields: [kategoriId],references: [id])
  jumlah Int @default(0)
  gambar_produk String? 
  public_id String?

  vendorsId Int
  vendors vendors @relation(fields: [vendorsId],references: [id])

  lokasiId Int
  lokasi lokasi_gudang @relation(fields: [lokasiId], references: [id])

  inbound barang_masuk[]
  outbound barang_keluar[]
}

// Tabel inbound 
model barang_masuk{
  id Int @id @default(autoincrement())
  produkId Int
  produk produk @relation(fields: [produkId], references: [id])
  tanggal_masuk DateTime @default(now())
  nominal_modal Int
  jumlah_barang_masuk Int
}

// Tabel Outbound
model barang_keluar{
  id Int @id @default(autoincrement())
  produkId Int
  produk produk @relation(fields: [produkId], references: [id])
  tanggal_keluar DateTime @default(now())
  nominal_modal Int
  jumlah_barang_keluar Int
}
